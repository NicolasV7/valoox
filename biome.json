{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "web/**/*.ts",
      "web/**/*.tsx",
      "test/**/*.ts",
      "scripts/**/*.mjs",
      "scripts/**/*.ts",
      "design/**/*.css",
      "public/**/*.js",
      "vitest.config.ts",
      "!public/qr.js",
      "!public/app.js",
      "!public/app.css",
      "!worker-configuration.d.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useTemplate": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
