node_modules/
.wrangler/
.dev.vars
*.log
.playwright-mcp/
worker-configuration.d.ts

# Fetched by `npm run fonts`. SIL OFL 1.1 permits shipping them; keeping a
# binary out of a public repo is the reason, not the licence.
public/fonts/

# Fetched by `npm run art`. Riot's artwork — the coins, the tiers, the sprays.
# Same reason as the fonts: wrangler uploads public/ at deploy, so it reaches
# production without sitting in a public history.
public/art/

# Built by `npm run build` from web/. wrangler uploads public/ at deploy.
public/app.js
public/app.css
